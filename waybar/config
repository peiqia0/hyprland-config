{
    "height": 34,
    "spacing": 4,
    "modules-left": ["hyprland/workspaces"],
    "modules-right": ["cpu", "memory", "disk", "temperature", "battery", "pulseaudio", "network", "clock"],
    "clock": {
        "format": "{:%H:%M %d/%m/%Y}"
    },
    "network": {
        "format-wifi": "UP {bandwidthUpBits} DOWN {bandwidthDownBits} {essid} ",
        "format-ethernet": "UP {bandwidthUpBits} DOWN {bandwidthDownBits} ETH",
        "format-disconnected": "No Network"
    },
    "pulseaudio": {
        "format": "VOL {volume}%"
    },
    "cpu": {
        "interval": 2,
        "format": "CPU {usage}%"
    },
    "memory": {
        "interval": 2,
        "format": "RAM {percentage}%"
    },
    "disk": {
        "interval": 30,
        "format": "DISK {percentage_used}%",
        "path": "/"
    },
    "temperature": {
        "interval": 2,
        "format": "TEMP {temperatureC}°C"
    },
    "battery": {
        "format": "BAT {capacity}%",
        "format-charging": "CHR {capacity}%",
        "format-discharging": "BAT {capacity}%"
    }
}
